+/// Whether `path` starts at the root. Windows does not call a path that
+/// starts with '/' absolute, and every path the phone's config names does.
+fn rooted(path: &Path) -> bool {
+    path.is_absolute() || path.to_string_lossy().starts_with('/')
+}
+
+/// Whether `path` is made of plain names, without `.` or `..` in it.
+fn plain(path: &Path) -> bool {
+    path.to_string_lossy()
+        .split('/')
+        .filter(|s| !s.is_empty())
+        .all(|s| s != "." && s != ".." && !s.contains('\\'))
+}
