+/// Keep the network just joined for the next run.
+fn remember(ssid: &[u8], security: Security, password: &str) {
+    let Ok(commands) = supplicant::network_commands(0, ssid, security, password, false) else { return };
+    let mut block = String::from("network={\n");
+    for command in commands {
+        let Some(rest) = command.strip_prefix("SET_NETWORK 0 ") else { continue };
+        let Some((name, value)) = rest.split_once(' ') else { continue };
+        block.push('\t');
+        block.push_str(name);
+        block.push('=');
+        block.push_str(value);
+        block.push('\n');
+    }
+    block.push_str("\tpriority=1\n}\n");
+    let name: String = ssid.iter().map(|b| format!("{b:02x}")).collect();
+    let write = |dir: &Path| -> std::io::Result<()> {
+        fs::create_dir_all(dir)?;
+        fs::write(dir.join(format!("{name}.conf")), &block)
+    };
+    let dir = Path::new(SAVED);
+    if write(dir).is_err() {
+        let _ = std::process::Command::new("mount").args(["-o", "rw,remount", "/metadata"]).status();
+        let _ = write(dir);
+    }
