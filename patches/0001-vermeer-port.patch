+        for entry in std::fs::read_dir(&d).with_context(|| format!("read {}", d.display()))? {
+            let entry = entry?;
+            let path = entry.path();
+            let name = path.strip_prefix(dir).with_context(|| format!("{} is under {}", path.display(), dir.display()))?;
+            let name = name.to_string_lossy().replace('\\', "/");
+            if entry.file_type()?.is_dir() {
+                stack.push(path);
+                continue;
+            }
+            let data = std::fs::read(&path).with_context(|| format!("read {}", path.display()))?;
+            let mode = if name.ends_with(".so") || name.ends_with(".txt") || name.ends_with(".ini") { 0o644 } else { 0o755 };
